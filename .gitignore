node_modules/
# Word lock files and temp files
~$*
*.tmp
# inbox is a drop zone: files are moved into the application folder once processed
inbox/*
!inbox/.gitkeep
# job listing: temporary CSV (rebuilt by tools/joblist.mjs build)
joblist/job_listing.csv

# ---- PRIVATE: personal data, never commit to the public repo ----
master/
applications/
tracker.csv
job_listing.xlsx
joblist/joblist.json
joblist/*.csv
inbox_state.json
*.pdf
*.docx
!examples/**
.claude/settings.local.json
